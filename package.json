{
  "name": "inkwell-blog",
  "version": "1.0.0",
  "private": true,
  "description": "A polished Express and PostgreSQL sample blog",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:create": "createdb inkwell",
    "check": "find src scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.23.0"
  }
}
